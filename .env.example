# 基础服务配置
PORT=3000
NODE_ENV=development

# MySQL 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DB_DATABASE=nest_admin
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Redis 缓存配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# JWT 鉴权配置
JWT_SECRET=super_secret_jwt_key_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Swagger / Knife4j 文档配置
SWAGGER_ENABLE=true
SWAGGER_PATH=api-docs
SWAGGER_AUTH_USER=admin
SWAGGER_AUTH_PASS=admin123
